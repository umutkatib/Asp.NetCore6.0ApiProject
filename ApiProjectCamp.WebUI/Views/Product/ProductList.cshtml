@model List<ResultProductDto>

@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Ürünler</h4>
                    <a href="/Product/ProductCreate" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Ürün Ekle
                    </a>
                </div>
                <div class="card-body">

                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz ürün eklenmemiş.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Görsel</th>
                                        <th>Ürün Adı</th>
                                        <th>Açıklama</th>
                                        <th>Kategori</th>
                                        <th>Fiyat</th>
                                        <th>Durumu</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td><img src="@item.ProductImageURl" alt="@item.ProductName" style="width:60px;height:60px;object-fit:cover;border-radius:8px;" /></td>
                                            <td>@item.ProductName</td>
                                            <td>@item.ProductDescription</td>
                                            <td>@item.CategoryName</td>
                                            <td>@item.ProductPrice.ToString("N2") ₺</td>
                                            <td>
                                                <span class="badge badge-@(item.ProductStatus ? "success" : "secondary")">
                                                    @(item.ProductStatus ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                            <td class="text-center text-nowrap">
                                                <a href="/Product/ProductUpdate/@item.ProductID" class="btn btn-sm btn-warning" title="Güncelle">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Product/ProductChangeStatus/@item.ProductID"
                                                   class="btn btn-sm @(item.ProductStatus ? "btn-secondary" : "btn-success")"
                                                   title="@(item.ProductStatus ? "Pasif Yap" : "Aktif Yap")">
                                                    <i class="fas @(item.ProductStatus ? "fa-eye-slash" : "fa-eye")"></i>
                                                </a>
                                                <a href="/Product/ProductDelete/@item.ProductID" class="btn btn-sm btn-danger" title="Sil">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>