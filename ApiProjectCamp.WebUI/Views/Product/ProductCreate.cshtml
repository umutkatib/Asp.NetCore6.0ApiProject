@model CreateProductDto

@{
    ViewData["Title"] = "Yeni Ürün";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .section-title {
        display: flex;
        align-items: center;
        margin: 4px 0 16px;
    }

        .section-title .no {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #6777ef;
            color: #fff;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        .section-title h6 {
            margin: 0;
            font-weight: 700;
            color: #34395e;
        }

    .form-block {
        padding-bottom: 8px;
        margin-bottom: 22px;
        border-bottom: 1px dashed #e3e6ef;
    }

        .form-block:last-of-type {
            border-bottom: 0;
        }

    .price-input {
        font-size: 22px;
        font-weight: 800;
        height: 54px;
    }

    .price-addon {
        font-size: 20px;
        font-weight: 700;
        background: #f0f2ff;
        color: #6777ef;
    }

    .char-counter {
        font-size: 12px;
        color: #98a6ad;
    }

    .menu-card-wrap {
        position: sticky;
        top: 90px;
    }

    .menu-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 14px 40px rgba(103,119,239,.22);
    }

        .menu-card .mc-img {
            height: 230px;
            background: linear-gradient(135deg, #eef0ff, #e3f6ff);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #b5bdf5;
            font-size: 56px;
        }

            .menu-card .mc-img img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: none;
            }

        .menu-card .mc-cat {
            position: absolute;
            left: 14px;
            top: 14px;
            z-index: 2;
            background: rgba(255,255,255,.95);
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            color: #6777ef;
            display: none;
        }

        .menu-card .mc-body {
            padding: 20px 22px 24px;
        }

        .menu-card .mc-name {
            font-size: 20px;
            font-weight: 800;
            color: #34395e;
            word-break: break-word;
        }

        .menu-card .mc-desc {
            font-size: 14px;
            color: #98a6ad;
            margin: 8px 0 16px;
            min-height: 42px;
            word-break: break-word;
        }

        .menu-card .mc-price {
            font-size: 26px;
            font-weight: 800;
            color: #6777ef;
        }

        .menu-card .empty {
            color: #c1c7d6;
            font-weight: 500;
        }

    .preview-label {
        text-align: center;
        font-size: 12px;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #98a6ad;
        margin-bottom: 12px;
    }
</style>

<section class="section">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h4 class="mb-1"><i class="fas fa-plus-circle mr-2 text-primary"></i>Yeni Ürün Ekle</h4>
            <div class="text-muted">Bilgileri doldurun, ürününüz menüde nasıl görüneceğini sağdan izleyin.</div>
        </div>
        <a href="/Product/ProductList" class="btn btn-light mt-2 mt-md-0"><i class="fas fa-arrow-left"></i> Listeye Dön</a>
    </div>

    <form asp-action="ProductCreate" method="post" id="productForm" novalidate>
        <div class="row">

            <div class="col-lg-7 order-2 order-lg-1">
                <div class="card">
                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-block">
                            <div class="section-title"><span class="no">1</span><h6>Temel Bilgiler</h6></div>
                            <div class="form-group">
                                <label asp-for="ProductName">Ürün Adı</label>
                                <input asp-for="ProductName" class="form-control" placeholder="Örn: Izgara Köfte" autocomplete="off" />
                                <span asp-validation-for="ProductName" class="text-danger small"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="ProductDescription">Açıklama</label>
                                <textarea asp-for="ProductDescription" class="form-control" rows="3" maxlength="200"
                                          placeholder="Ürünü birkaç cümleyle anlatın"></textarea>
                                <div class="d-flex justify-content-between">
                                    <span asp-validation-for="ProductDescription" class="text-danger small"></span>
                                    <div class="char-counter ml-auto"><span id="descCount">0</span> / 200</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-block">
                            <div class="section-title"><span class="no">2</span><h6>Fiyat ve Kategori</h6></div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="ProductPrice">Fiyat</label>
                                        <div class="input-group">
                                            <input asp-for="ProductPrice" type="number" step="0.01" min="0" class="form-control price-input" placeholder="0.00" />
                                            <div class="input-group-append"><span class="input-group-text price-addon">₺</span></div>
                                        </div>
                                        <span asp-validation-for="ProductPrice" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CategoryID">Kategori</label>
                                        <select asp-for="CategoryID" class="form-control" style="height:54px;"
                                                asp-items="@((List<SelectListItem>)ViewBag.categoryValues)">
                                            <option value="">Kategori seçin</option>
                                        </select>
                                        <span asp-validation-for="CategoryID" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-block">
                            <div class="section-title"><span class="no">3</span><h6>Görsel</h6></div>
                            <div class="form-group">
                                <label asp-for="ProductImageURl">Görsel Yolu</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><div class="input-group-text"><i class="fas fa-image"></i></div></div>
                                    <input asp-for="ProductImageURl" class="form-control" autocomplete="off"
                                           placeholder="/yummy-red-1.0.0/assets/img/menu/menu-item-1.png" />
                                </div>
                                <span asp-validation-for="ProductImageURl" class="text-danger small"></span>
                                <small id="imgHint" class="form-text text-muted">Yolu yazdığınızda görsel sağdaki kartta belirir.</small>
                            </div>
                        </div>

                        <div class="text-right">
                            <a href="/Product/ProductList" class="btn btn-light mr-1">Vazgeç</a>
                            <button type="submit" class="btn btn-primary btn-lg" id="btnSubmit">
                                <i class="fas fa-check"></i> Ürünü Kaydet
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-5 order-1 order-lg-2 mb-4">
                <div class="menu-card-wrap">
                    <div class="preview-label"><i class="fas fa-eye mr-1"></i> Menü Önizlemesi</div>
                    <div class="menu-card">
                        <div class="mc-img">
                            <i class="fas fa-utensils" id="mcIcon"></i>
                            <img id="mcImg" alt="" />
                            <span class="mc-cat" id="mcCat"></span>
                        </div>
                        <div class="mc-body">
                            <div class="mc-name empty" id="mcName">Ürün adı</div>
                            <div class="mc-desc empty" id="mcDesc">Ürün açıklaması burada görünecek.</div>
                            <div class="mc-price" id="mcPrice">0,00 ₺</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var $ = function (id) { return document.getElementById(id); };
            var name = $('ProductName'), desc = $('ProductDescription'), price = $('ProductPrice'),
                img = $('ProductImageURl'), cat = $('CategoryID');
            var mcImg = $('mcImg'), mcIcon = $('mcIcon');

            function setText(el, value, placeholder) {
                el.textContent = value || placeholder;
                el.classList.toggle('empty', !value);
            }

            function refresh() {
                setText($('mcName'), name.value.trim(), 'Ürün adı');
                setText($('mcDesc'), desc.value.trim(), 'Ürün açıklaması burada görünecek.');
                $('descCount').textContent = desc.value.length;

                var p = parseFloat(price.value);
                $('mcPrice').textContent = (isNaN(p) ? 0 : p).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';

                var opt = cat.options[cat.selectedIndex];
                var mcCat = $('mcCat');
                if (cat.value && opt) { mcCat.textContent = opt.text; mcCat.style.display = 'block'; }
                else { mcCat.style.display = 'none'; }
            }

            function refreshImage() {
                var src = img.value.trim();
                if (!src) { mcImg.style.display = 'none'; mcIcon.style.display = ''; return; }
                mcImg.src = src;
            }
            mcImg.onload  = function () { mcImg.style.display = 'block'; mcIcon.style.display = 'none'; $('imgHint').textContent = 'Görsel bulundu.'; };
            mcImg.onerror = function () { mcImg.style.display = 'none'; mcIcon.style.display = ''; $('imgHint').textContent = 'Bu yolda bir görsel bulunamadı.'; };

            [name, desc, price, cat].forEach(function (el) {
                el.addEventListener('input', refresh);
                el.addEventListener('change', refresh);
            });
            img.addEventListener('change', refreshImage);
            img.addEventListener('input', function () { clearTimeout(img._t); img._t = setTimeout(refreshImage, 400); });

            $('productForm').addEventListener('submit', function () {
                if (!window.jQuery || $(this).valid()) {
                    var btn = document.getElementById('btnSubmit');
                    btn.classList.add('btn-progress');
                    setTimeout(function () { btn.disabled = true; }, 0);
                }
            });

            refresh(); refreshImage();
        })();
    </script>
}