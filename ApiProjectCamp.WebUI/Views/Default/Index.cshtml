
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_HeaderDefaultPartialComponent")

<body class="index-page">

    @await Component.InvokeAsync("_NavbarDefaultPartialComponent")

    <main class="main">

        <!-- Hero Section -->
        @await Component.InvokeAsync("_FeatureDefaultPartialComponent")
        <!-- /Hero Section -->

        <!-- About Section -->
        @await Component.InvokeAsync("_AboutDefaultPartialComponent")
        <!-- /About Section -->

        <!-- Why Us Section -->
        @await Component.InvokeAsync("_ServiceDefaultPartialComponent")
        <!-- /Why Us Section -->

        <!-- Stats Section -->
        @await Component.InvokeAsync("_HomePageStatisticsPartialComponent")
        <!-- /Stats Section -->

        <!-- Menu Section -->
        @await Component.InvokeAsync("_DefaultMenuPartialComponent")
        <!-- /Menu Section -->

        <!-- Testimonials Section -->
        @await Component.InvokeAsync("_TestimonialDefaultPartialComponent")
        <!-- /Testimonials Section -->

        <!-- Events Section -->
        @await Component.InvokeAsync("_EventDefaultPartialComponent")
        <!-- /Events Section -->

        <!-- Chefs Section -->
        @await Component.InvokeAsync("_ChefDefaultPartialComponent")
        <!-- /Chefs Section -->

        <!-- Book A Table Section -->
        @await Component.InvokeAsync("_BookingDefaultPartialComponent")
        <!-- /Book A Table Section -->

        <!-- Gallery Section -->
        @await Component.InvokeAsync("_GalleryDefaultPartialComponent")
        <!-- /Gallery Section -->

        <!-- Contact Section -->
        @await Component.InvokeAsync("_ContactDefaultPartialComponent")
        <!-- /Contact Section -->

    </main>

    @await Component.InvokeAsync("_FooterDefaultPartialComponent")


    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    @await Component.InvokeAsync("_ScriptDefaultPartialComponent")

</body>

</html>