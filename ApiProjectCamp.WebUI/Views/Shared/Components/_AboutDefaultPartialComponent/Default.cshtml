@model List<ResultAboutDto>

@{
    var about = Model?.FirstOrDefault();
}

@if (about != null)
{
    <section id="about" class="about section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>Hakkımızda<br></h2>
            <p><span>@about.AboutTitle</span> <span class="description-title">Hakkımızda</span></p>
        </div><!-- End Section Title -->

        <div class="container">

            <div class="row gy-4">
                <div class="col-lg-7" data-aos="fade-up" data-aos-delay="100">
                    <img src="@about.AboutImageUrl" class="img-fluid mb-4" alt="@about.AboutTitle">
                    <div class="book-a-table">
                        <h3>Masa Rezervasyonu</h3>
                        <p>@about.AboutReservationNumber</p>
                    </div>
                </div>
                <div class="col-lg-5" data-aos="fade-up" data-aos-delay="250">
                    <div class="content ps-0 ps-lg-5">
                        <p class="fst-italic">@about.AboutIntroText</p>
                        <ul>
                            <li><i class="bi bi-check-circle-fill"></i> <span>@about.AboutItem1</span></li>
                            <li><i class="bi bi-check-circle-fill"></i> <span>@about.AboutItem2</span></li>
                            <li><i class="bi bi-check-circle-fill"></i> <span>@about.AboutItem3</span></li>
                        </ul>
                        <p>@about.AboutDescription</p>

                        <div class="position-relative mt-4">
                            <img src="@about.AboutVideoCoverImageUrl" class="img-fluid" alt="">
                            <a href="@about.AboutVideoUrl" class="glightbox pulsating-play-btn"></a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>
}