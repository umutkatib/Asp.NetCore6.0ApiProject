@model List<ResultProductDto>

<div class="tab-content" data-aos="fade-up" data-aos-delay="200">

    <div class="tab-pane fade active show" id="menu-all">
        <div class="tab-header text-center">
            <p>Menü</p>
            <h3>Tüm Lezzetler</h3>
        </div>
        <div class="row gy-5">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 menu-item">
                    <a href="@item.ProductImageURl" class="glightbox"><img src="@item.ProductImageURl" class="menu-img img-fluid" alt="@item.ProductName"></a>
                    <h4>@item.ProductName</h4>
                    <p class="ingredients">@item.ProductDescription</p>
                    <p class="price">@item.ProductPrice ₺</p>
                </div>
            }
        </div>
    </div>

    @foreach (var group in Model.GroupBy(x => new { x.CategoryID, x.CategoryName }))
    {
        <div class="tab-pane fade" id="menu-@group.Key.CategoryID">
            <div class="tab-header text-center">
                <p>Menü</p>
                <h3>@group.Key.CategoryName</h3>
            </div>
            <div class="row gy-5">
                @foreach (var item in group)
                {
                    <div class="col-lg-4 menu-item">
                        <a href="@item.ProductImageURl" class="glightbox"><img src="@item.ProductImageURl" class="menu-img img-fluid" alt="@item.ProductName"></a>
                        <h4>@item.ProductName</h4>
                        <p class="ingredients">@item.ProductDescription</p>
                        <p class="price">@item.ProductPrice ₺</p>
                    </div>
                }
            </div>
        </div>
    }

</div>