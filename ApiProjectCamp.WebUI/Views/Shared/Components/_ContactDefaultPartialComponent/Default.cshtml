@model List<ResultContactDto>

<section id="contact" class="contact section">

    <!-- Başlık -->
    <div class="container section-title" data-aos="fade-up">
        <h2>İletişim</h2>
        <p>
            <span>Yardıma İhtiyacınız Var mı?</span>
            <span class="description-title">Bize Yazın</span>
        </p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        @foreach (var item in Model)
        {
            <!-- Harita -->
            <div class="mb-5">
                <iframe style="width: 100%; height: 400px;"
                        src="@item.ContactMapLocation"
                        frameborder="0"
                        allowfullscreen>
                </iframe>
            </div>

            <!-- İletişim Bilgileri -->
            <div class="row gy-4">

                <div class="col-md-6">
                    <div class="info-item d-flex align-items-center">
                        <i class="icon bi bi-geo-alt flex-shrink-0"></i>
                        <div>
                            <h3>Adres</h3>
                            <p>@item.ContactAddress</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item d-flex align-items-center">
                        <i class="icon bi bi-telephone flex-shrink-0"></i>
                        <div>
                            <h3>Telefon</h3>
                            <p>@item.ContactPhone</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item d-flex align-items-center">
                        <i class="icon bi bi-envelope flex-shrink-0"></i>
                        <div>
                            <h3>Email Adresimiz</h3>
                            <p>@item.ContactEmail</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-item d-flex align-items-center">
                        <i class="icon bi bi-clock flex-shrink-0"></i>
                        <div>
                            <h3>Çalışma Saatlerimiz</h3>
                            <p>@Html.Raw(item.ContactOpenHours)</p>
                        </div>
                    </div>
                </div>

            </div>
        }

        <!-- Mesaj Gönderme Formu -->
        <div class="mt-5">
            @await Component.InvokeAsync(
            "_MessageSendDefaultPartialComponent")
        </div>

    </div>
</section>
