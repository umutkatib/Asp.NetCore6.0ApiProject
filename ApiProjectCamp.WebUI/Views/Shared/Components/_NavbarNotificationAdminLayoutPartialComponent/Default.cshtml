@model List<ResultNotificationDto>

@{
    var unreadCount = Model.Count(x => x.NotificationStatus == false);
}

<li class="dropdown dropdown-list-toggle">
    <a href="#" data-toggle="dropdown"
       class="nav-link notification-toggle nav-link-lg @(unreadCount > 0 ? "beep" : "")">
        <i data-feather="bell" class="bell"></i>
    </a>
    <div class="dropdown-menu dropdown-list dropdown-menu-right pullDown">
        <div class="dropdown-header">
            Bildirimler @(unreadCount > 0 ? $"({unreadCount})" : "")
            <div class="float-right">
                <a href="/Notification/MarkAllAsRead">Tümünü Okundu İşaretle</a>
            </div>
        </div>
        <div class="dropdown-list-content dropdown-list-icons">
            @foreach (var item in Model)
            {
                <a href="/Notification/NotificationDetail/@item.NotificationID" class="dropdown-item @(item.NotificationStatus ? "" : "dropdown-item-unread")">
                    <span class="dropdown-item-icon bg-@(item.NotificationStatus ? "secondary" : "primary") text-white">
                        <i class="@item.NotificationIconURl"></i>
                    </span> <span class="dropdown-item-desc">
                        @item.NotificationDescription
                        <span class="time">
                            @item.NotificationDate.ToString("HH:mm")
                        </span>
                    </span>
                </a>
            }
        </div>
        <div class="dropdown-footer text-center">
            <a href="/Notification/NotificationList">Hepsini Gör <i class="fas fa-chevron-right"></i></a>
        </div>
    </div>
</li>