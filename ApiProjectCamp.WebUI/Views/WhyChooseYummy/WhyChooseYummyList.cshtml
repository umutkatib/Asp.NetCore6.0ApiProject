@model List<ResultWhyChooseYummyDto>

@{
    ViewData["Title"] = "Neden Yummy?";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Neden Bizi Seçmelisiniz?</h4>
                    @if (Model == null || Model.Count < 3)
                    {
                        <a href="/WhyChooseYummy/WhyChooseYummyCreate" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Yeni Yummy Ekle
                        </a>
                    }
                    
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz kayıt eklenmemiş.</div>
                    }
                    else
                    {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>İkon</th>
                                    <th>İkon Sınıfı</th>
                                    <th>Başlık</th>
                                    <th>Açıklama</th>
                                    <th class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td><i class="@item.ServiceIconUrl" style="font-size:22px;"></i></td>
                                        <td>@item.ServiceIconUrl</td>
                                        <td>@item.ServiceTitle</td>
                                        <td>@item.ServiceDescription</td>
                                        <td class="text-center">
                                            <a href="/WhyChooseYummy/WhyChooseYummyUpdate/@item.ServiceID" class="btn btn-sm btn-warning">Güncelle</a>
                                            <a href="/WhyChooseYummy/WhyChooseYummyDelete/@item.ServiceID" class="btn btn-sm btn-danger">Sil</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>