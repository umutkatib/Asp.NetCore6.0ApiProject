@model UpdateChefDto

@{
    ViewData["Title"] = "Şef Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-10 col-md-10 col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h4>Şef Güncelle</h4>
                </div>
                <div class="card-body">
                    <div class="text-danger mb-3">@ViewBag.Error</div>

                    <form asp-action="ChefUpdate" method="post">
                        <input type="hidden" asp-for="ChefID" />

                        <div class="row">
                            <div class="col-lg-4 text-center mb-4">
                                <img src="@Model.ChefImageUrl" alt="@Model.ChefNameSurname"
                                     style="width:200px;height:200px;object-fit:cover;border-radius:50%;box-shadow:0 4px 12px rgba(0,0,0,.2);" />
                                <h6 class="mt-3 mb-0">@Model.ChefNameSurname</h6>
                                <small class="text-muted">@Model.ChefTitle</small>
                            </div>

                            <div class="col-lg-8">
                                <div class="form-group">
                                    <label asp-for="ChefNameSurname">Ad Soyad</label>
                                    <input asp-for="ChefNameSurname" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label asp-for="ChefTitle">Unvan</label>
                                    <input asp-for="ChefTitle" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label asp-for="ChefDescription">Açıklama</label>
                                    <textarea asp-for="ChefDescription" class="form-control" rows="4"></textarea>
                                </div>
                                <div class="form-group">
                                    <label asp-for="ChefImageUrl">Görsel Yolu</label>
                                    <input asp-for="ChefImageUrl" class="form-control" />
                                </div>
                                <button type="submit" class="btn btn-primary">Güncelle</button>
                                <a href="/Chef/ChefList" class="btn btn-secondary">Vazgeç</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>