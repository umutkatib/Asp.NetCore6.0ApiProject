
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_HeaderAdminLayoutPartialComponent")

<body>
    <div class="loader"></div>
    <div id="app">
        <div class="main-wrapper main-wrapper-1">
            @await Component.InvokeAsync("_NavbarAdminLayoutPartialComponent")

            
            @await Component.InvokeAsync("_SidebarAdminLayoutPartialComponent")

            <!-- Main Content -->
            <div class="main-content">
               @RenderBody()
                @await Component.InvokeAsync("_RightSettingsAdminLayoutPartialComponent")
            </div>

            <footer class="main-footer">
                <div class="footer-left">
                    <a href="templateshub.net">Templateshub</a></a>
                </div>
                <div class="footer-right">
                </div>
            </footer>
        </div>
    </div>
    <!-- General JS Scripts -->
    <script src="~/otika-bootstrap-admin-template/assets/js/app.min.js"></script>
    <!-- JS Libraies -->
    <script src="~/otika-bootstrap-admin-template/assets/bundles/apexcharts/apexcharts.min.js"></script>
    <!-- Page Specific JS File -->
    <script src="~/otika-bootstrap-admin-template/assets/js/page/index.js"></script>
    <!-- Template JS File -->
    <script src="~/otika-bootstrap-admin-template/assets/js/scripts.js"></script>
    <!-- Custom JS File -->
    <script src="~/otika-bootstrap-admin-template/assets/js/custom.js"></script>

</body>


<!-- index.html  21 Nov 2019 03:47:04 GMT -->
</html>
