@model List<ResultCategoryDto>

@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Kategoriler</h4>
                    <a href="/Category/CategoryCreate" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Kategori Ekle
                    </a>
                </div>
                <div class="card-body">

                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz kategori eklenmemiş.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Kategori Adı</th>
                                        <th scope="col">Durumu</th>
                                        <th scope="col" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>@item.CategoryName</td>
                                            <td>
                                                <span class="badge badge-@(item.CategoryStatus ? "success" : "secondary")">
                                                    @(item.CategoryStatus ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a href="/Category/CategoryUpdate/@item.CategoryID" class="btn btn-sm btn-warning">Güncelle</a>
                                                <a href="/Category/CategoryChangeStatus/@item.CategoryID" class="btn btn-sm btn-info">
                                                    @(item.CategoryStatus ? "Pasif Yap" : "Aktif Yap")
                                                </a>
                                                <a href="/Category/CategoryDelete/@item.CategoryID" class="btn btn-sm btn-danger">Sil</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>