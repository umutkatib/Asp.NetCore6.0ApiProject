@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Müşteri Yorumları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Müşteri Yorumları</h4>
                    <a href="/Testimonial/TestimonialCreate" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Yorum Ekle
                    </a>
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz yorum eklenmemiş.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Görsel</th>
                                        <th>Ad Soyad</th>
                                        <th>Unvan</th>
                                        <th>Yorum</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>
                                                <img src="@item.TestimonialImageURl" alt="@item.TestimonialNameSurname"
                                                     style="width:50px;height:50px;object-fit:cover;border-radius:50%;" />
                                            </td>
                                            <td>@item.TestimonialNameSurname</td>
                                            <td>@item.TestimonialTitle</td>
                                            <td>@item.TestimonialComment</td>
                                            <td class="text-center">
                                                <a href="/Testimonial/TestimonialUpdate/@item.TestimonialID" class="btn btn-sm btn-warning">Güncelle</a>
                                                <a href="/Testimonial/TestimonialDelete/@item.TestimonialID" class="btn btn-sm btn-danger">Sil</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>