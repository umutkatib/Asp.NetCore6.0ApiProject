@model UpdateTestimonialDto

@{
    ViewData["Title"] = "Yorum Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-10 col-md-10 col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h4>Yorum Güncelle</h4>
                </div>
                <div class="card-body">
                    <div class="text-danger mb-3">@ViewBag.Error</div>

                    <form asp-action="TestimonialUpdate" method="post">
                        <input type="hidden" asp-for="TestimonialID" />

                        <div class="form-group">
                            <label asp-for="TestimonialNameSurname">Ad Soyad</label>
                            <input asp-for="TestimonialNameSurname" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="TestimonialTitle">Unvan</label>
                            <input asp-for="TestimonialTitle" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="TestimonialComment">Yorum</label>
                            <textarea asp-for="TestimonialComment" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="form-group">
                            <label asp-for="TestimonialImageURl">Görsel Yolu</label>
                            <input asp-for="TestimonialImageURl" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                        <a href="/Testimonial/TestimonialList" class="btn btn-secondary">Vazgeç</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>