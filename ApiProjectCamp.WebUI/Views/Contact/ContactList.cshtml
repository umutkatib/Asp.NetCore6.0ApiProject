@model List<ResultContactDto>

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>İletişim Bilgileri</h4>
                    @if (Model == null || !Model.Any())
                    {
                        <a href="/Contact/ContactCreate" class="btn btn-primary">Yeni İletişim Bilgisi</a>
                    }
                    
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info text-center mb-0">
                            Henüz kayıtlı iletişim bilgisi bulunmuyor. <h4>Sadece 1 tane</h4> iletişim bilgisi eklenebilir.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Adres</th>
                                        <th>Telefon</th>
                                        <th>E-posta</th>
                                        <th>Çalışma Saatleri</th>
                                        <th>Harita</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.ContactAddress</td>
                                            <td>@item.ContactPhone</td>
                                            <td>@item.ContactEmail</td>
                                            <td>@item.ContactOpenHours</td>
                                            <td style="max-width:200px;" class="text-truncate" title="@item.ContactMapLocation">
                                                @item.ContactMapLocation
                                            </td>
                                            <td class="text-nowrap">
                                                <a href="/Contact/ContactUpdate/@item.ContactID" class="btn btn-sm btn-success">Güncelle</a>
                                                <a href="/Contact/ContactDelete/@item.ContactID" class="btn btn-sm btn-danger">Sil</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>