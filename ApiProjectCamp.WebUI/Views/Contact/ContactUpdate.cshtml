@model UpdateContactDto

@{
    ViewData["Title"] = "İletişim Bilgisi Güncelleme";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-10 col-md-10 col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h4>İletişim Bilgisi Güncelle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ContactUpdate" method="post">
                        <input type="hidden" asp-for="ContactID" />

                        <div class="form-group">
                            <label asp-for="ContactAddress">Adres</label>
                            <textarea asp-for="ContactAddress" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="ContactPhone">Telefon</label>
                                <input asp-for="ContactPhone" type="tel" class="form-control" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="ContactEmail">E-posta</label>
                                <input asp-for="ContactEmail" type="email" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="ContactOpenHours">Çalışma Saatleri</label>
                            <input asp-for="ContactOpenHours" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="ContactMapLocation">Harita Konumu (Embed URL)</label>
                            <textarea asp-for="ContactMapLocation" class="form-control" rows="3"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">Güncelle</button>
                        <a href="/Contact/ContactList" class="btn btn-secondary">Vazgeç</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>