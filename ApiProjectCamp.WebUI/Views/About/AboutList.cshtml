@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Hakkımızda";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4><i class="fas fa-info-circle mr-2"></i>Hakkımızda</h4>
                    @if (Model == null || !Model.Any())
                    {
                        <a href="/About/AboutCreate" class="btn btn-primary">
                            <i class="fas fa-plus mr-1"></i> Yeni Hakkımızda Ekle
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info text-center mb-0">
                            Henüz kayıt eklenmemiş.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Görsel</th>
                                        <th>Video Kapak</th>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Rezervasyon No</th>
                                        <th class="text-center">Video</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.AboutImageUrl))
                                                {
                                                    <img src="@item.AboutImageUrl" alt="@item.AboutTitle"
                                                         width="80" class="rounded border" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted"><i class="far fa-image fa-2x"></i></span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.AboutVideoCoverImageUrl))
                                                {
                                                    <img src="@item.AboutVideoCoverImageUrl" alt="@item.AboutTitle"
                                                         width="80" class="rounded border" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted"><i class="far fa-image fa-2x"></i></span>
                                                }
                                        </td>
                                        <td><strong>@item.AboutTitle</strong></td>
                                        <td title="@item.AboutDescription">
                                            @(item.AboutDescription?.Length > 80
                                                                                    ? item.AboutDescription.Substring(0, 80) + "..."
                                                                                    : item.AboutDescription)
                                    </td>
                                    <td class="text-nowrap">
                                        <i class="fas fa-phone-alt text-muted mr-1"></i>@item.AboutReservationNumber
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(item.AboutVideoUrl))
                                                {
                                                    <a href="@item.AboutVideoUrl" target="_blank" rel="noopener"
                                                       class="btn btn-sm btn-info" title="Videoyu izle">
                                                        <i class="fas fa-play"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center text-nowrap">
                                                <a href="/About/AboutUpdate/@item.AboutID" class="btn btn-sm btn-primary mr-1" title="Güncelle">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/About/AboutDelete/@item.AboutID" class="btn btn-sm btn-danger" title="Sil"
                                                   onclick="return confirm('Bu kaydı silmek istediğine emin misin?')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>