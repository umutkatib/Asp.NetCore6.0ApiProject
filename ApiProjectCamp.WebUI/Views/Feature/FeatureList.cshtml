@model List<ResultFeatureDto>

@{
    ViewData["Title"] = "Öne Çıkan Alanlar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Öne Çıkan Alanlar</h4>
                    @if (Model == null || !Model.Any())
                    {
                        <a href="/Feature/FeatureCreate" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Yeni Öne Çıkan Ekle
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz kayıt eklenmemiş.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Görsel</th>
                                        <th>Başlık</th>
                                        <th>Alt Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Video</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <img src="@item.FeatureImageUrl" alt="@item.FeatureTitle"
                                                     style="width:70px;height:50px;object-fit:cover;border-radius:6px;" />
                                            </td>
                                            <td>@item.FeatureTitle</td>
                                            <td>@item.FeatureSubTitle</td>
                                            <td>@item.FeatureDescription</td>
                                            <td>
                                                <a href="@item.FeatureVideoUrl" target="_blank" rel="noopener" class="btn btn-sm btn-light">
                                                    <i class="fas fa-play-circle"></i> İzle
                                                </a>
                                            </td>
                                            <td class="text-center text-nowrap">
                                                <a href="/Feature/FeatureUpdate/@item.FeatureID" class="btn btn-sm btn-warning" title="Güncelle">
                                                    <i class="fas fa-edit"></i>
                                                </a>                                 
                                                <a href="/Feature/FeatureDelete/@item.FeatureID" class="btn btn-sm btn-danger" title="Sil">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>