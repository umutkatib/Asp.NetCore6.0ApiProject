@model List<ResultYummyEventDto>

@{
    ViewData["Title"] = "Özel Etkinlikler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Özel Etkinlikler</h4>
                    <a href="/YummyEvent/YummyEventCreate" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Etkinlik Ekle
                    </a>
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">Henüz etkinlik eklenmemiş.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Görsel</th>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Fiyat</th>
                                        <th>Durum</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>
                                                <img src="@item.YummyEventImageUrl" alt="@item.YummyEventTitle"
                                                     style="width:70px;height:50px;object-fit:cover;border-radius:6px;" />
                                            </td>
                                            <td>@item.YummyEventTitle</td>
                                            <td>@item.YummyEventDescription</td>
                                            <td>@item.YummyEventPrice.ToString("N2") ₺</td>
                                            <td>
                                                <span class="badge @(item.YummyEventStatus ? "badge-success" : "badge-secondary")">
                                                    @(item.YummyEventStatus ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                            <td class="text-center text-nowrap">
                                                <a href="/YummyEvent/YummyEventUpdate/@item.YummyEventID" class="btn btn-sm btn-warning" title="Güncelle">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/YummyEvent/YummyEventChangeStatus/@item.YummyEventID"
                                                   class="btn btn-sm @(item.YummyEventStatus ? "btn-secondary" : "btn-success")"
                                                   title="@(item.YummyEventStatus ? "Pasif Yap" : "Aktif Yap")">
                                                    <i class="fas @(item.YummyEventStatus ? "fa-eye-slash" : "fa-eye")"></i>
                                                </a>
                                                <a href="/YummyEvent/YummyEventDelete/@item.YummyEventID" class="btn btn-sm btn-danger" title="Sil">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>