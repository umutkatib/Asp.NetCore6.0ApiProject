@model UpdateMessageDto

@{
    ViewData["Title"] = "Mesaj Güncelleme";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="row justify-content-center">
        <div class="col-10 col-md-10 col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h4>Mesaj Güncelle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="MessageUpdate" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <input type="hidden" asp-for="MessageID" />

                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="MessageNameSurname">Ad Soyad</label>
                                <input asp-for="MessageNameSurname" class="form-control" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="MessageEmail">E-posta</label>
                                <input asp-for="MessageEmail" type="email" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-md-8">
                                <label asp-for="MessageSubject">Konu</label>
                                <input asp-for="MessageSubject" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="MessageDetails">Mesaj</label>
                            <textarea asp-for="MessageDetails" class="form-control" rows="5"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">Güncelle</button>
                        <a href="/Message/MessageList" class="btn btn-secondary">Vazgeç</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>